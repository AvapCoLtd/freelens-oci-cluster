{
  "name": "freelens-oci-cluster",
  "version": "0.6.0",
  "description": "FreeLens extension that shows the OCI resources backing the open cluster (nodes, load balancers, storage)",
  "main": "out/main/index.js",
  "type": "module",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "node": ">= 22.0.0",
    "freelens": "^2.0.0"
  },
  "license": "MIT",
  "author": "Avap Co., Ltd.",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.avaper.day/avap/freelens-plugins/freelens-oci-cluster.git"
  },
  "homepage": "https://github.com/AvapCoLtd/freelens-oci-cluster#readme",
  "bugs": {
    "url": "https://github.com/AvapCoLtd/freelens-oci-cluster/issues"
  },
  "scripts": {
    "type:check": "tsc -p src/common && tsc -p src/main && tsc -p src/renderer && tsc -p src && tsc -p tsconfig.json",
    "prebuild": "pnpm type:check",
    "build": "vite build && vite build --mode main",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@freelensapp/extensions": "2.0.0",
    "@types/node": "~24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "^12.11.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens"
  ]
}
